# USB QR scanner configuration
#
# This file uses the same format as your Klipper configuration and is parsed
# the same way, so anything Klipper would accept works here too.
#
# Copy it into your Klipper config directory so that it survives updates of
# this repository and can be edited from Mainsail/Fluidd:
#
#     cp qr-scanner.conf.example ~/printer_data/config/qr-scanner.conf
#
# Then restart the service:
#
#     systemctl --user restart usb-qr-scanner
#
# Only the settings listed below are recognised; anything else is ignored with
# a warning.  Values are read literally - shell expansion is NOT performed.

[qr_scanner]

# Path to your scanner's input device.  Find yours with:
#     ls -l /dev/input/by-id/ | grep event-kbd
event_dev: /dev/input/by-id/usb-TMS_HIDKeyBoard_1234567890abcd-event-kbd

# Where scans are sent.  The defaults suit a scanner plugged into the printer
# host itself, and can also be set at runtime by scanning a Moonraker QR code.
#moonraker_scheme: http
#moonraker_host: localhost
#moonraker_port: 7125

# Prefixes recognised in scanned codes.
#spoolman_prefix: web+spoolman:s-
#moonraker_prefix: web+moonraker:
